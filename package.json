{
  "name": "tern-cli",
  "version": "0.1.0",
  "description": "One command to diagnose your development environment.",
  "type": "module",
  "bin": {
    "tern": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "cli",
    "doctor",
    "dx",
    "developer-experience",
    "environment",
    "linter",
    "diagnostics",
    "nodejs",
    "typescript"
  ],
  "author": "Tern Authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tern-tools/tern"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "boxen": "^9.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "ora": "^9.4.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
